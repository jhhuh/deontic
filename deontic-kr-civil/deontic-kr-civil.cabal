cabal-version: 3.0
name:          deontic-kr-civil
version:       0.2.0.0
synopsis:      Korean Civil Act (민법) with type-level stratified deontic logic
license:       AGPL-3.0-or-later
license-file:  LICENSE

library
  exposed-modules:
    Deontic.Civil
    Deontic.Civil.Types
    Deontic.Civil.Persons
    Deontic.Civil.Acts
    Deontic.Civil.Agency
    Deontic.Civil.CoOwnership
    Deontic.Civil.Possession
    Deontic.Civil.Prescription
    Deontic.Civil.Tort
    Deontic.Civil.Rescission
    Deontic.Civil.PropertyTransfer
    Deontic.Civil.AcquisitivePrescription
    Deontic.Civil.DefaultObligation
    Deontic.Civil.SaleWarranty
    Deontic.Civil.Lease
    Deontic.Civil.AgencyRemedies
    Deontic.Civil.Invalidity
    Deontic.Civil.Cancellation
    Deontic.Civil.ConditionalAct
    Deontic.Civil.Render
  hs-source-dirs: src
  build-depends:
    base       >= 4.17 && < 5,
    deontic-core,
    containers >= 0.6,
    text       >= 2.0,
    time       >= 1.11
  default-language: GHC2021
  default-extensions:
    GADTs
    DataKinds
    TypeFamilies
    TypeApplications
    MultiParamTypeClasses
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    UndecidableInstances
    OverloadedStrings

executable deontic-kr-civil-demo
  main-is:          Demo.hs
  hs-source-dirs:   app
  build-depends:
    base       >= 4.17 && < 5,
    deontic-core,
    deontic-kr-civil,
    containers >= 0.6,
    text       >= 2.0,
    time       >= 1.11
  default-language: GHC2021
  default-extensions:
    GADTs
    DataKinds
    TypeFamilies
    TypeApplications
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    OverloadedStrings

executable deontic-kr-civil-cli
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base       >= 4.17 && < 5,
    deontic-core,
    deontic-kr-civil,
    containers >= 0.6,
    text       >= 2.0,
    time       >= 1.11
  default-language: GHC2021
  default-extensions:
    GADTs
    DataKinds
    TypeFamilies
    TypeApplications
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    OverloadedStrings

test-suite deontic-kr-civil-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    base       >= 4.17 && < 5,
    deontic-kr-civil,
    deontic-core,
    containers >= 0.6,
    text       >= 2.0,
    time       >= 1.11,
    hspec      >= 2.0
  other-modules:
    Deontic.Civil.PersonsSpec
    Deontic.Civil.ActsSpec
    Deontic.Civil.AgencySpec
    Deontic.Civil.CaseSpec
    Deontic.Civil.CaseStudySpec
    Deontic.Civil.RealCasesSpec
    Deontic.Civil.CoOwnershipSpec
    Deontic.Civil.PossessionSpec
    Deontic.Civil.PrescriptionSpec
    Deontic.Civil.TortSpec
    Deontic.Civil.RescissionSpec
    Deontic.Civil.PropertyTransferSpec
    Deontic.Civil.AcquisitivePrescriptionSpec
    Deontic.Civil.DefaultObligationSpec
    Deontic.Civil.SaleWarrantySpec
    Deontic.Civil.LeaseSpec
    Deontic.Civil.AgencyRemediesSpec
    Deontic.Civil.InvaliditySpec
    Deontic.Civil.CancellationSpec
    Deontic.Civil.ConditionalActSpec
    Deontic.Civil.RenderSpec
  build-tool-depends:
    hspec-discover:hspec-discover
  default-language: GHC2021
  default-extensions:
    GADTs
    DataKinds
    TypeFamilies
    TypeApplications
    FlexibleContexts
    FlexibleInstances
    ScopedTypeVariables
    OverloadedStrings
